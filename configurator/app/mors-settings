#!/usr/bin/env python3
"""mors-settings — окно настроек райса.

Интерфейс — configurator/prototype/configurator.html в окне GTK + WebKit;
Python выполняет то, что из браузера сделать нельзя:
  • тема всей системы  → rice.py apply <тема>
  • обновление райса   → git pull --ff-only + rice.py apply <текущая> + hyprctl reload
  • HyprPanel          → чтение/запись ~/.config/hyprpanel/config.json (с резервной копией)
  • слежка за rice/current и config.json — окно перекрашивается и перечитывает файл само.

    mors-settings              открыть (второй запуск поднимает уже открытое окно)
    mors-settings --system     открыть сразу на странице «Система»

Нужны: python-gobject, gtk3, webkit2gtk-4.1.
"""
import datetime, hashlib, json, os, pathlib, shutil, subprocess, sys, threading

APP_ID = 'io.github.k0kfjjfkdjf.MorsSettings'
HERE = pathlib.Path(__file__).resolve().parent              # configurator/app
DOTS = HERE.parent.parent                                   # корень mors-dots
RICE = DOTS / 'rice'
UI = HERE.parent / 'prototype/configurator.html'
HOME = pathlib.Path.home()


def jsonc_error(text):
    """None, если текст — верный JSON с комментариями // /* */ и висячими запятыми (как читает fastfetch),
    иначе «строка N, символ M: …»."""
    import re
    out, i, n, q = [], 0, len(text), False
    while i < n:
        c = text[i]
        if q:
            out.append(c)
            if c == '\\' and i + 1 < n:
                out.append(text[i + 1]); i += 2; continue
            if c == '"':
                q = False
        elif c == '"':
            q = True; out.append(c)
        elif text.startswith('//', i):
            while i < n and text[i] != '\n':
                out.append(' '); i += 1
            continue
        elif text.startswith('/*', i):
            j = text.find('*/', i + 2); j = n if j < 0 else j + 2
            out.append(re.sub(r'[^\n]', ' ', text[i:j])); i = j; continue
        else:
            out.append(c)
        i += 1
    clean = re.sub(r',(\s*[}\]])', r' \1', ''.join(out))
    try:
        json.loads(clean)
        return None
    except json.JSONDecodeError as e:
        return f'строка {e.lineno}, символ {e.colno}: {e.msg}'
HP_CONFIG = HOME / '.config/hyprpanel/config.json'
STATE_DIR = pathlib.Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config')) / 'mors-settings'
CACHE_DIR = pathlib.Path(os.environ.get('XDG_CACHE_HOME', HOME / '.cache')) / 'mors-settings'
BYPASS = CACHE_DIR / 'allow-hyprpanel-settings'             # см. gear-redirect.py


# ======================================================================== команды (без GTK)
def run(cmd, cwd=None, timeout=600):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    return p.returncode, (p.stdout + p.stderr).strip()


def git(*args):
    return run(['git', '-C', str(DOTS), *args], timeout=180)


class Backend:
    def __init__(self, log=lambda text, kind='': None):
        self.log = log                      # потоковый вывод в «терминал» страницы «Система»
        self.last_hp_hash = None            # чтобы не принимать собственную запись за внешнюю
        self.backed_up = False
        self.hypr_backed = set()             # резервная копия каждого файла Hyprland — раз за сеанс

    # ---------------------------------------------------------------- состояние
    def settings(self):
        try:
            return json.loads((STATE_DIR / 'settings.json').read_text())
        except Exception:
            return {}

    def save_settings(self, **kw):
        s = self.settings(); s.update(kw)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        (STATE_DIR / 'settings.json').write_text(json.dumps(s, ensure_ascii=False, indent=2))

    def current_theme(self):
        try:
            return (RICE / 'current').read_text().strip()
        except OSError:
            return None

    def repo(self):
        if not (DOTS / '.git').exists():
            return None
        _, branch = git('rev-parse', '--abbrev-ref', 'HEAD')
        _, info = git('log', '-1', '--format=%H%x1f%s%x1f%cd', '--date=format:%d.%m.%Y %H:%M')
        commit, subject, date = (info.split('\x1f') + ['', '', ''])[:3]
        _, dirty = git('status', '--porcelain', '--untracked-files=no')
        return {'branch': branch, 'commit': commit, 'subject': subject, 'date': date,
                'dirty': len([l for l in dirty.splitlines() if l.strip()])}

    def gear_running(self):
        try:
            pid = int((CACHE_DIR / 'gear-redirect.pid').read_text())
            return b'gear-redirect' in pathlib.Path(f'/proc/{pid}/cmdline').read_bytes()
        except (OSError, ValueError):
            return False

    def cmd_state(self, open=None):
        hp = None
        if HP_CONFIG.exists():
            text = HP_CONFIG.read_text()
            self.last_hp_hash = hashlib.sha1(text.encode()).hexdigest()
            hp = {'path': '~/' + str(HP_CONFIG.relative_to(HOME)), 'text': text}
        return {'dots': str(DOTS), 'theme': self.current_theme(), 'repo': self.repo(),
                'hyprpanel': hp, 'zoom': self.settings().get('zoom', 100),
                'gear': self.gear_running(), 'open': open}

    # ---------------------------------------------------------------- тема
    def rice(self, *args):
        cmd = [sys.executable, '-u', str(RICE / 'rice.py'), *args]   # -u: шаги видны сразу, а не в конце
        self.log('$ rice.py ' + ' '.join(args), 'c')
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in p.stdout:
            line = line.rstrip()
            if line:
                self.log(line)
        return p.wait()

    def cmd_applyTheme(self, name):
        themes = {f.stem for f in (RICE / 'themes').glob('*.json')}
        if name not in themes:
            raise ValueError(f'нет темы «{name}»')
        code = self.rice('apply', name)
        return {'ok': code == 0, 'code': code}

    # ---------------------------------------------------------------- обновление
    def cmd_updateRice(self):
        if not (DOTS / '.git').exists():
            raise RuntimeError(f'{DOTS} — не git-репозиторий')
        self.log('$ git fetch', 'c')
        code, out = git('fetch', '--prune')
        if code:
            return {'ok': False, 'message': '✗ git fetch: ' + out, 'repo': self.repo()}
        code, upstream = git('rev-parse', '--abbrev-ref', '@{u}')
        if code:
            return {'ok': False, 'message': '✗ у ветки нет upstream на GitHub', 'repo': self.repo()}
        _, behind = git('rev-list', '--count', 'HEAD..@{u}')
        if behind.strip() == '0':
            return {'ok': True, 'message': '✓ уже последняя версия', 'repo': self.repo()}
        _, changed = git('diff', '--name-only', 'HEAD', '@{u}')
        changed = changed.splitlines()
        self.log(f'новых коммитов: {behind.strip()}, файлов: {len(changed)}')
        # Локальные правки в файлах, которые меняет обновление, — иначе git pull откажется.
        _, dirty = git('diff', '--name-only', 'HEAD')
        clash = sorted(set(dirty.split()) & set(changed))
        stashed = []
        for f in clash:
            _, theirs = git('show', f'@{{u}}:{f}')
            try:
                same = (DOTS / f).read_text().rstrip('\n') == theirs.rstrip('\n')
            except OSError:
                same = False
            if same:                                          # правка уже есть в новой версии
                git('checkout', '--', f)
            else:
                stashed.append(f)
        if stashed:
            self.log(f'локальные правки в {", ".join(stashed)} — откладываю (git stash)')
            code, out = git('stash', 'push', '-m', f'mors-settings: перед обновлением {datetime.datetime.now():%Y-%m-%d %H:%M}',
                            '--', *stashed)
            if code:
                return {'ok': False, 'message': '✗ не получилось отложить правки: ' + out, 'repo': self.repo()}
        self.log(f'$ git pull --ff-only ({upstream})', 'c')
        code, out = git('pull', '--ff-only')
        for line in out.splitlines()[-8:]:
            self.log(line)
        if code:
            if stashed:
                git('stash', 'pop')                           # вернуть как было
            return {'ok': False, 'message': '✗ git pull не прошёл — см. вывод выше', 'repo': self.repo()}
        kept_aside = []
        if stashed:
            code, out = git('stash', 'pop')
            if code:                                          # правки конфликтуют с новой версией
                git('reset', '-q', '--', *stashed)
                git('checkout', '--', *stashed)
                kept_aside = stashed
                self.log(f'! твои правки в {", ".join(stashed)} не совпали с новой версией: оставлена новая, '
                         f'твои сохранены в git stash (посмотреть: git -C {DOTS} stash show -p)', 'err')
            else:
                self.log(f'✓ твои правки в {", ".join(stashed)} возвращены поверх новой версии', 'ok')
        theme = self.current_theme()
        if theme:
            self.rice('apply', theme)
        if shutil.which('hyprctl'):
            self.log('$ hyprctl reload', 'c')
            run(['hyprctl', 'reload'])
        need = any(c.startswith(('packages/', 'install.sh', 'hosts/', 'rice/sddm')) for c in changed)
        return {'ok': True, 'message': f'✓ обновлено до {self.repo()["commit"][:7]}', 'repo': self.repo(),
                'needInstall': need, 'keptAside': kept_aside}

    def cmd_runInstaller(self):
        term = shutil.which('kitty') or shutil.which('foot') or shutil.which('alacritty')
        if not term:
            raise RuntimeError('не нашёл терминал (kitty)')
        script = f'{DOTS}/install.sh -y; echo; read -p "Готово. Enter — закрыть "'
        subprocess.Popen([term, '-e', 'bash', '-c', script], start_new_session=True)
        return True

    # ---------------------------------------------------------------- HyprPanel
    def cmd_writeHyprPanel(self, text):
        json.loads(text)                                  # не пишем битый JSON
        backup = None
        if HP_CONFIG.exists() and not self.backed_up:
            backup = HP_CONFIG.with_name(f'config.json.bak-{datetime.datetime.now():%Y%m%d-%H%M%S}')
            shutil.copy2(HP_CONFIG, backup)
            self.backed_up = True
            backup = backup.name
        HP_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        tmp = HP_CONFIG.with_suffix('.json.mors-tmp')
        tmp.write_text(text)
        self.last_hp_hash = hashlib.sha1(text.encode()).hexdigest()
        os.replace(tmp, HP_CONFIG)                        # HyprPanel перечитает файл сам
        return {'backup': backup}

    def cmd_openHyprPanelSettings(self):
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        BYPASS.touch()                                    # gear-redirect пропустит одно открытие
        run(['hyprpanel', 'toggleWindow', 'settings-dialog'])
        return True

    def cmd_startGear(self):
        subprocess.Popen([sys.executable, str(HERE / 'gear-redirect.py')], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True

    # ---------------------------------------------------------------- Hyprland (настоящие файлы)
    def _hypr_root(self):
        return (HOME / '.config/hypr').resolve()

    def _hypr_allowed(self, real):
        """Писать можно только в конфиг Hyprland и в hosts/ репозитория (туда ведёт lua/host.lua)."""
        real = real.resolve()
        roots = [self._hypr_root(), (DOTS / 'hosts').resolve()]
        return real.suffix in ('.lua', '.conf') and any(real.is_relative_to(r) for r in roots)

    def cmd_hyprland(self):
        root = self._hypr_root()
        main = root / 'hyprland.lua'
        fmt = 'lua'
        if not main.exists():
            main, fmt = root / 'hyprland.conf', 'conf'
        if not main.exists():
            return {'files': []}
        import re
        order, seen = [], set()

        def walk(path):
            if path in seen or not path.exists():
                return
            seen.add(path); order.append(path)
            text = path.read_text()
            if fmt == 'lua':
                for mod in re.findall(r'^\s*require\s*\(?\s*["\']([\w.]+)["\']\s*\)?\s*$', text, re.M):
                    walk(root / (mod.replace('.', '/') + '.lua'))
            else:
                for src in re.findall(r'^\s*source\s*=\s*(.+?)\s*$', text, re.M):
                    walk(pathlib.Path(os.path.expanduser(src)))
        walk(main)
        disp = lambda p: '~/.config/hypr/' + str(p.relative_to(root)) if p.is_relative_to(root) else str(p)
        return {'format': fmt, 'files': [{'path': disp(p), 'text': p.read_text()} for p in order]}

    def cmd_writeHypr(self, path, text, reload=False):
        p = pathlib.Path(os.path.expanduser(path))
        if not self._hypr_allowed(p):
            raise PermissionError(f'запись вне конфига Hyprland запрещена: {path}')
        real = p.resolve()                                 # host.lua — ссылка: пишем в настоящий файл
        backup = None
        if real.exists() and real not in self.hypr_backed:
            bdir = CACHE_DIR / 'backups' / f'{datetime.datetime.now():%Y%m%d-%H%M%S}'
            bdir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(real, bdir / real.name)
            self.hypr_backed.add(real)
            backup = f'~/.cache/mors-settings/backups/{bdir.name}/{real.name}'
        real.parent.mkdir(parents=True, exist_ok=True)
        tmp = real.with_name(real.name + '.mors-tmp')
        tmp.write_text(text)
        os.replace(tmp, real)
        out = self.cmd_hyprReload() if reload else None
        return {'backup': backup, 'reload': out}

    def cmd_hyprReload(self):
        if not shutil.which('hyprctl'):
            return {'ok': False, 'out': 'нет hyprctl'}
        code, out = run(['hyprctl', 'reload'], timeout=20)
        return {'ok': code == 0, 'out': out}

    # ---------------------------------------------------------------- конфиги (настоящие файлы)
    BUILTIN = [
        {'id': 'hyprland', 'name': 'Hyprland', 'builtin': True},
        {'id': 'kitty', 'name': 'Kitty', 'builtin': True, 'path': '~/.config/kitty/kitty.conf', 'format': 'space',
         'comment': '#', 'marker': '@', 'follow': True, 'reload': 'pkill -USR1 -x kitty'},
        {'id': 'fastfetch', 'name': 'fastfetch', 'builtin': True, 'path': '~/.config/fastfetch/config.jsonc',
         'format': 'jsonc', 'comment': '//', 'marker': '@', 'follow': False},
    ]
    FORMAT_SRC = {   # строки подключения других файлов
        'conf': r'^\s*source\s*=\s*(.+?)\s*$', 'space': r'^\s*include\s+(.+?)\s*$',
        'ini': r'^\s*include\s*=\s*(.+?)\s*$', 'lua': r'^\s*(?:dofile|require)\s*\(?\s*["\']([^"\']+)["\']\s*\)?\s*$'}

    def _user_configs(self):
        return self.settings().get('configs', [])

    def _allowed(self, p):
        real = pathlib.Path(os.path.expanduser(str(p))).resolve()
        roots = [(HOME / '.config').resolve(), DOTS.resolve(), (HOME / '.local/share').resolve()]
        return any(real.is_relative_to(r) for r in roots)

    @staticmethod
    def _disp(p):
        p = pathlib.Path(p)
        return '~/' + str(p.relative_to(HOME)) if p.is_relative_to(HOME) else str(p)

    def _read_tree(self, cfg):
        """Главный файл + всё, что он подключает (рекурсивно, без повторов)."""
        import re
        main = pathlib.Path(os.path.expanduser(cfg['path']))
        rx = re.compile(self.FORMAT_SRC.get(cfg.get('format', 'conf'), r'(?!)'), re.M)
        order, seen = [], set()

        def walk(path):
            key = path.absolute()
            if key in seen or not path.is_file():
                return
            seen.add(key); order.append(path)
            if not cfg.get('follow', True):
                return
            for target in rx.findall(path.read_text(errors='replace')):
                if cfg.get('format') == 'lua' and '/' not in target and not target.endswith('.lua'):
                    nxt = main.parent / (target.replace('.', '/') + '.lua')
                else:
                    t = pathlib.Path(os.path.expanduser(target))
                    nxt = t if t.is_absolute() else path.parent / t
                if any(ch in str(nxt) for ch in '*?['):          # include с маской — все подходящие
                    for g in sorted(nxt.parent.glob(nxt.name)):
                        walk(g)
                else:
                    walk(nxt)
        walk(main)
        return [{'path': self._disp(p), 'text': p.read_text(errors='replace')} for p in order]

    def cmd_configs(self):
        out = []
        for c in self.BUILTIN + self._user_configs():
            c = dict(c)
            try:
                if c['id'] == 'hyprland':
                    h = self.cmd_hyprland()
                    c.update(format=h.get('format', 'lua'), comment='#' if h.get('format') == 'conf' else '--',
                             marker='@', follow=True, path='~/.config/hypr/hyprland.' + h.get('format', 'lua'),
                             files=h['files'])
                else:
                    c['files'] = self._read_tree(c)
            except Exception as e:
                c['files'], c['error'] = [], str(e)
            out.append(c)
        return out

    def cmd_addConfig(self, cfg):
        p = pathlib.Path(os.path.expanduser(cfg['path']))
        if not p.is_file():
            raise FileNotFoundError(f'нет файла {cfg["path"]}')
        if not self._allowed(p):
            raise PermissionError('можно добавлять файлы из ~/.config, ~/.local/share и mors-dots')
        lst = [c for c in self._user_configs() if c['id'] != cfg.get('id')]
        cfg = {k: cfg[k] for k in ('name', 'path', 'format', 'comment', 'marker', 'start', 'follow', 'reload') if k in cfg}
        cfg['id'] = 'u-' + hashlib.sha1(str(p).encode()).hexdigest()[:8]
        lst = [c for c in lst if c['id'] != cfg['id']] + [cfg]
        self.save_settings(configs=lst)
        return {**cfg, 'files': self._read_tree(cfg)}

    def cmd_updateConfig(self, cfg):
        if cfg.get('id') in ('hyprland', 'kitty'):
            return True
        lst = [dict(c, **{k: cfg[k] for k in ('name', 'format', 'comment', 'marker', 'start', 'follow', 'reload') if k in cfg})
               if c['id'] == cfg['id'] else c for c in self._user_configs()]
        self.save_settings(configs=lst)
        return True

    def cmd_removeConfig(self, id):
        self.save_settings(configs=[c for c in self._user_configs() if c['id'] != id])
        return True

    def cmd_writeConfigFile(self, id, path, text, reload=True):
        if id == 'hyprland':
            return self.cmd_writeHypr(path, text, reload=reload)
        p = pathlib.Path(os.path.expanduser(path))
        if not self._allowed(p):
            raise PermissionError(f'запись вне ~/.config и mors-dots запрещена: {path}')
        real = p.resolve()
        cfg = next((c for c in self.BUILTIN + self._user_configs() if c['id'] == id), {})
        if cfg.get('format') == 'jsonc' or real.suffix in ('.json', '.jsonc'):
            err = jsonc_error(text)                     # битый JSON не пишем — программа (fastfetch) не запустится
            if err:
                raise ValueError(f'не сохранил {path}: получился неверный JSON ({err}). Файл на диске не тронут')
        backup = None
        if real.exists() and real not in self.hypr_backed:
            bdir = CACHE_DIR / 'backups' / f'{datetime.datetime.now():%Y%m%d-%H%M%S}'
            bdir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(real, bdir / real.name)
            self.hypr_backed.add(real)
            backup = f'~/.cache/mors-settings/backups/{bdir.name}/{real.name}'
        real.parent.mkdir(parents=True, exist_ok=True)
        tmp = real.with_name(real.name + '.mors-tmp')
        tmp.write_text(text)
        os.replace(tmp, real)
        do_reload, reload = reload, None
        if do_reload and cfg.get('reload'):
            import shlex
            code, out = run(shlex.split(cfg['reload']), timeout=20)
            reload = {'cmd': cfg['reload'], 'ok': code in (0, 1), 'out': out}     # pkill: 1 — некому слать
        return {'backup': backup, 'reload': reload}

    # ---------------------------------------------------------------- шрифты и выбор файлов
    _fonts = None

    def cmd_fonts(self):
        """Установленные шрифты: семейство → начертания (fc-list)."""
        if self._fonts is None:
            fams = {}
            if shutil.which('fc-list'):
                _, out = run(['fc-list', '--format', '%{family[0]}\t%{style[0]}\n'], timeout=20)
                for line in out.splitlines():
                    fam, _, style = line.partition('\t')
                    if fam.strip():
                        fams.setdefault(fam.strip(), set()).add(style.strip() or 'Regular')
            order = {'Regular': 0, 'Book': 0, 'Normal': 0, 'Medium': 1, 'Italic': 2, 'Bold': 3}
            self._fonts = [{'family': f, 'styles': sorted(st, key=lambda x: (order.get(x, 5), x))}
                           for f, st in sorted(fams.items(), key=lambda kv: kv[0].lower())]
        return self._fonts

    picker = None          # окно выбора файла на GTK — подставляет App (нужен главный поток)
    IMAGE_EXT = '*.png *.jpg *.jpeg *.webp *.gif *.bmp *.tif *.tiff'

    def cmd_pickFile(self, kind='file', start=None, title=None, multiple=False, filter=None, tilde=False):
        """Системное окно выбора: kind = file | image | dir. Возвращает путь (или список) либо None.
        filter — маски через пробел («*.png *.jpg»): в окне видны только такие файлы.
        tilde — вернуть путь в домашней папке как ~/… (как было записано в конфиге)."""
        res = self._pick(kind, start, title, multiple, filter)
        if tilde and res:
            fix = lambda x: '~' + x[len(str(HOME)):] if x == str(HOME) or x.startswith(str(HOME) + '/') else x
            res = [fix(x) for x in res] if isinstance(res, list) else fix(res)
        return res

    def cmd_globInfo(self, pattern):
        """Сколько файлов подходит под путь с маской (~/x/*.png) — для подсказки под полем."""
        import glob as g
        pat = os.path.expanduser(str(pattern or '').strip())
        if not pat:
            return {'count': 0, 'sample': [], 'dir': False}
        if not g.has_magic(pat):
            return {'count': 1 if os.path.exists(pat) else 0, 'sample': [os.path.basename(pat)], 'dir': os.path.isdir(pat)}
        found = sorted(x for x in g.glob(pat) if os.path.isfile(x))
        return {'count': len(found), 'sample': [os.path.basename(x) for x in found[:5]],
                'dir': os.path.isdir(os.path.dirname(pat))}

    def _pick(self, kind, start, title, multiple, filter):
        start = os.path.expanduser(start or '~')
        if any(ch in start for ch in '*?['):               # путь с маской — открываем её папку
            start = os.path.dirname(start)
        if not os.path.exists(start):
            start = os.path.dirname(start.rstrip('/')) or str(HOME)
            if not os.path.isdir(start):
                start = str(HOME)
        title = title or {'dir': 'Выбери папку', 'image': 'Выбери картинку'}.get(kind, 'Выбери файл')
        if shutil.which('kdialog'):                       # окно KDE — как в Dolphin
            if kind == 'dir':
                cmd = ['kdialog', '--title', title, '--getexistingdirectory', start]
            else:
                cmd = ['kdialog', '--title', title] + (['--multiple', '--separate-output'] if multiple else []) + \
                      ['--getopenfilename', start] + ([f'Подходящие ({filter})'] if filter else
                                                      [f'Картинки ({self.IMAGE_EXT})'] if kind == 'image' else [])
            p = subprocess.run(cmd, capture_output=True, text=True)
            if p.returncode != 0:
                return None
            out = [l for l in p.stdout.splitlines() if l.strip()]
            return out if multiple else (out[0] if out else None)
        if self.picker:                                   # GTK / портал рабочего стола
            return self.picker(kind, start, title, multiple, filter)
        if shutil.which('zenity'):
            cmd = ['zenity', '--file-selection', '--title', title, '--filename', start.rstrip('/') + '/']
            if kind == 'dir':
                cmd.append('--directory')
            if multiple:
                cmd += ['--multiple', '--separator', '\n']
            if filter or kind == 'image':
                cmd += ['--file-filter', f'Подходящие | {filter}' if filter else f'Картинки | {self.IMAGE_EXT}']
            p = subprocess.run(cmd, capture_output=True, text=True)
            if p.returncode != 0:
                return None
            out = [l for l in p.stdout.splitlines() if l.strip()]
            return out if multiple else (out[0] if out else None)
        raise RuntimeError('нет окна выбора файлов: поставь kdialog (sudo pacman -S kdialog)')

    def cmd_importWallpapers(self):
        """Выбрать картинки и скопировать их в папку текущей темы."""
        name = self.current_theme()
        if not name:
            raise RuntimeError('тема не выбрана')
        files = self.cmd_pickFile('image', '~/Изображения' if (HOME / 'Изображения').is_dir() else '~',
                                  'Картинки для обоев темы', multiple=True) or []
        dest = RICE / 'wallpapers' / name
        dest.mkdir(parents=True, exist_ok=True)
        added = []
        for f in files:
            src = pathlib.Path(f)
            if src.is_file():
                target = dest / src.name
                if target.exists() and target.read_bytes() != src.read_bytes():
                    target = dest / f'{src.stem}-{datetime.datetime.now():%H%M%S}{src.suffix}'
                if not target.exists():
                    shutil.copy2(src, target)
                    added.append(target.name)
        return {'added': added}

    # ---------------------------------------------------------------- мониторы
    def _warm_flag(self):
        sig = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
        return pathlib.Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / 'hypr' / sig / 'mors-warm-done' if sig else None

    def cmd_displays(self):
        """Мониторы (с режимами, которые они поддерживают) + таблица MON из hosts/<машина>/hypr.lua."""
        raw = os.environ.get('MORS_MONITORS_JSON')
        if raw is None:
            if not shutil.which('hyprctl'):
                return {'monitors': [], 'host': None}
            _, raw = run(['hyprctl', 'monitors', 'all', '-j'], timeout=10)
        try:
            mons = json.loads(raw)
        except Exception:
            mons = []
        host = HOME / '.config/hypr/lua/host.lua'
        flag = self._warm_flag()
        return {'monitors': [{k: m.get(k) for k in ('name', 'description', 'make', 'model', 'width', 'height',
                                                    'refreshRate', 'x', 'y', 'scale', 'transform', 'disabled',
                                                    'focused', 'availableModes')} for m in mons],
                'host': {'path': '~/.config/hypr/lua/host.lua', 'real': str(host.resolve()) if host.exists() else None,
                         'text': host.read_text() if host.exists() else None},
                'warmDone': bool(flag and flag.exists())}

    def cmd_applyMonitors(self, rules):
        """Применить сразу, без перечитывания конфига (иначе сбросится прогрев)."""
        if not shutil.which('hyprctl'):
            raise RuntimeError('нет hyprctl — окно запущено не в Hyprland?')
        out = []
        for r in rules:
            parts = [f'output = {json.dumps(r["output"])}', f'mode = {json.dumps(r["mode"])}',
                     f'position = {json.dumps(r["position"])}', f'scale = {float(r["scale"]):g}']
            if int(r.get('transform') or 0):
                parts.append(f'transform = {int(r["transform"])}')
            lua = 'hl.monitor({ ' + ', '.join(parts) + ' })'
            self.log('$ hyprctl eval ' + lua, 'c')
            code, res = run(['hyprctl', 'eval', lua], timeout=10)
            if not res.strip().startswith('ok'):        # старый .conf-конфиг понимает только keyword
                out_name = r['output']
                rule = f'{out_name},{r["mode"]},{r["position"]},{float(r["scale"]):g}' + \
                       (f',transform,{int(r["transform"])}' if int(r.get('transform') or 0) else '')
                code, res = run(['hyprctl', 'keyword', 'monitor', rule], timeout=10)
            out.append({'output': r['output'], 'ok': code == 0, 'out': res.strip()})
        return out

    def cmd_writeHost(self, text):
        return self.cmd_writeHypr('~/.config/hypr/lua/host.lua', text, reload=False)

    # ---------------------------------------------------------------- обои
    def _rice_mod(self):
        import importlib.util
        spec = importlib.util.spec_from_file_location('rice_mod', RICE / 'rice.py')
        m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
        return m

    def cmd_wallpapers(self):
        name = self.current_theme()
        if not name:
            return {'theme': None, 'files': []}
        r = self._rice_mod()
        files = r.theme_wallpapers(name)
        cur = r.selected_wallpaper(name, files)
        base = r.WP_DIR / name
        local = r.WP_DIR / 'local'
        left = sorted(f.name for f in local.glob('*') if f.suffix.lower() in r.WP_EXT) if local.is_dir() else []
        return {'theme': name, 'dir': str(base),
                'files': [{'rel': str(f.relative_to(base)), 'uri': f.as_uri(), 'default': f.name == r.WP_DEFAULT} for f in files],
                'current': str(cur.relative_to(base)) if cur else None, 'leftovers': left}

    def cmd_monitors(self):
        name = self.current_theme()
        r = self._rice_mod()
        files = r.theme_wallpapers(name) if name else []
        cur = r.selected_wallpaper(name, files) if name else None
        per = r.mon_state().get(name, {}) if name else {}
        out = []
        for m in r.monitors():
            e = per.get(m['key'])
            if e:
                src = r.WP_DIR / name / e['file']
                e = {**e, 'uri': src.as_uri() if src.exists() else None}
            out.append({**m, 'entry': e})
        return {'theme': name, 'monitors': out,
                'default': {'rel': str(cur.relative_to(r.WP_DIR / name)), 'uri': cur.as_uri()} if cur else None}

    def cmd_setMonitorWallpaper(self, key, rel=None, crop=None, rotate=0, flip=False):
        name = self.current_theme()
        r = self._rice_mod()
        r.set_monitor_wallpaper(name, key, rel, crop, rotate, flip)
        code = self.rice('wallpaper', 'fade')
        return {'ok': code == 0}

    def cmd_setWallpaper(self, rel):
        code = self.rice('set-wallpaper', rel)
        return {'ok': code == 0}

    def cmd_openWallpaperFolder(self):
        name = self.current_theme()
        d = RICE / 'wallpapers' / (name or '')
        d.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(['xdg-open', str(d)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True

    def cmd_setZoom(self, zoom):
        self.save_settings(zoom=int(zoom))
        return True


def ensure_session_env():
    """Запуск не из сессии Hyprland (SSH, TTY, старый tmux): находим работающий Hyprland сами."""
    run = os.environ.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    hypr = pathlib.Path(run) / 'hypr'
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE') and hypr.is_dir():
        live = [d for d in hypr.iterdir() if (d / '.socket2.sock').exists()]
        if live:
            os.environ['HYPRLAND_INSTANCE_SIGNATURE'] = max(live, key=lambda d: d.stat().st_mtime).name
    if not os.environ.get('WAYLAND_DISPLAY') and not os.environ.get('DISPLAY'):
        socks = sorted(p.name for p in pathlib.Path(run).glob('wayland-*') if not p.name.endswith('.lock'))
        if socks:
            os.environ['WAYLAND_DISPLAY'] = socks[0]


# ======================================================================== окно
def main():
    ensure_session_env()
    import gi
    gi.require_version('Gtk', '3.0')
    for v in ('4.1', '4.0'):
        try:
            gi.require_version('WebKit2', v); break
        except ValueError:
            continue
    else:
        msg = 'Нужен пакет webkit2gtk-4.1:  sudo pacman -S webkit2gtk-4.1'
        subprocess.run(['notify-send', 'mors-settings', msg]); sys.exit(msg)
    from gi.repository import Gio, GLib, Gtk, WebKit2

    GLib.set_prgname('mors-settings')
    GLib.set_application_name('Настройки')

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.win = self.view = None
            self.monitors = []
            self.backend = Backend(log=lambda text, kind='': self.emit({'type': 'log', 'text': text, 'kind': kind}))
            self.backend.picker = self.pick_gtk
            self.open_page = None

        # ---- JS <-> Python
        def js(self, code):
            if not self.view:
                return
            if hasattr(self.view, 'evaluate_javascript'):        # WebKitGTK 2.40+
                self.view.evaluate_javascript(code, -1, None, None, None, None, None)
            else:
                self.view.run_javascript(code, None, None, None)

        def emit(self, ev):
            GLib.idle_add(self.js, f'window.__morsEvent&&window.__morsEvent({json.dumps(ev, ensure_ascii=False)})')

        def reply(self, mid, ok, data):
            GLib.idle_add(self.js, f'window.__morsReply({mid},{str(ok).lower()},{json.dumps(data, ensure_ascii=False)})')

        def on_message(self, _manager, result):
            try:
                value = result.get_js_value().to_string()
            except AttributeError:
                value = result.to_string()
            msg = json.loads(value)
            if os.environ.get('MORS_DEBUG'):
                print('bridge:', msg['cmd'], file=sys.stderr, flush=True)
            fn = getattr(self.backend, 'cmd_' + msg['cmd'], None)

            def work():
                try:
                    if not fn:
                        raise ValueError('неизвестная команда ' + msg['cmd'])
                    args = msg.get('args') or {}
                    if msg['cmd'] == 'state':
                        args = {'open': self.open_page}
                        self.open_page = None
                    self.reply(msg['id'], True, fn(**args))
                except Exception as e:  # ошибка уходит в интерфейс тостом
                    self.reply(msg['id'], False, str(e))
            threading.Thread(target=work, daemon=True).start()

        # ---- окно выбора файла GTK (через портал рабочего стола, если он есть)
        def pick_gtk(self, kind, start, title, multiple, filter=None):
            done, box = threading.Event(), {}

            def show():
                action = Gtk.FileChooserAction.SELECT_FOLDER if kind == 'dir' else Gtk.FileChooserAction.OPEN
                dlg = Gtk.FileChooserNative.new(title, self.win, action, 'Выбрать', 'Отмена')
                dlg.set_select_multiple(bool(multiple))
                dlg.set_current_folder(start if os.path.isdir(start) else os.path.dirname(start))
                if filter or kind == 'image':
                    flt = Gtk.FileFilter(); flt.set_name('Подходящие' if filter else 'Картинки')
                    for ext in (filter or Backend.IMAGE_EXT).split():
                        flt.add_pattern(ext)
                    dlg.add_filter(flt)
                if dlg.run() == Gtk.ResponseType.ACCEPT:
                    box['v'] = dlg.get_filenames() if multiple else dlg.get_filename()
                dlg.destroy(); done.set()
                return False
            GLib.idle_add(show)
            done.wait()
            return box.get('v')

        # ---- слежка за файлами
        def watch(self, path, cb):
            mon = Gio.File.new_for_path(str(path.parent)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            def changed(_m, f, other, _event):
                for x in (f, other):
                    if x and x.get_basename() == path.name:
                        GLib.timeout_add(250, lambda: (cb(), False)[1]); return
            mon.connect('changed', changed)
            self.monitors.append(mon)

        def on_theme_file(self):
            name = self.backend.current_theme()
            if name:
                self.emit({'type': 'theme', 'name': name})

        def on_hp_file(self):
            try:
                text = HP_CONFIG.read_text()
                json.loads(text)
            except Exception:
                return                                     # файл пишется прямо сейчас
            h = hashlib.sha1(text.encode()).hexdigest()
            if h != self.backend.last_hp_hash:
                self.backend.last_hp_hash = h
                self.emit({'type': 'hyprpanel', 'text': text, 'external': True})

        # ---- жизненный цикл
        def do_command_line(self, cmdline):
            args = cmdline.get_arguments()[1:]
            if '--system' in args:
                self.open_page = 'system'
            if self.win:
                if self.open_page:
                    self.emit({'type': 'open', 'page': self.open_page}); self.open_page = None
                self.win.present()
            else:
                self.activate()
            return 0

        def do_activate(self):
            if self.win:
                self.win.present(); return
            if not UI.exists():
                sys.exit(f'Нет {UI} — собери: python {HERE.parent}/tools/build.py')
            manager = WebKit2.UserContentManager()
            manager.register_script_message_handler('mors')
            manager.connect('script-message-received::mors', self.on_message)
            self.view = WebKit2.WebView.new_with_user_content_manager(manager)
            s = self.view.get_settings()
            s.set_enable_developer_extras(True)
            s.set_allow_file_access_from_file_urls(True)
            self.view.load_uri(UI.as_uri())
            self.win = Gtk.ApplicationWindow(application=self, title='Настройки')
            self.win.set_default_size(1400, 880)
            self.win.add(self.view)
            self.win.show_all()
            self.watch(RICE / 'current', self.on_theme_file)
            self.watch(HP_CONFIG, self.on_hp_file)

    sys.exit(App().run(sys.argv))


if __name__ == '__main__':
    main()
