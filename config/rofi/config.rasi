//@file rofi — лаунчер
// Строки //@ — разметка для mors-settings: по ним рисуется окно настроек (rofi их не читает).
/*****----- Configuration -----*****/
configuration {
//@section Поведение
	//@name: Режимы | type: string | desc: Через запятую: drun, run, filebrowser, recursivebrowser, window, emoji, calc
	modi:                       "drun,filebrowser,run,recursivebrowser";
    //@name: Значки приложений | type: bool
    show-icons:                 true;
//@end
//@section Значки режимов
    //@name: Приложения | type: string | desc: Значок или текст на кнопке режима
    display-drun:               "";
    //@name: Команды | type: string | desc: Значок или текст на кнопке режима
    display-run:                "";
    //@name: Файлы | type: string | desc: Значок или текст на кнопке режима
    display-filebrowser:        "";
    //@name: Поиск файлов | type: string | desc: Значок или текст на кнопке режима
    display-recursivebrowser:   "󰈞";
    //@name: Эмодзи | type: string | desc: Значок или текст на кнопке режима
    display-emoji:              "󰞅";
    //@name: Окна | type: string | desc: Значок или текст на кнопке режима
    display-window:             "";
    //@name: Калькулятор | type: string | desc: Значок или текст на кнопке режима
    display-calc:               "";
//@end
//@section Подписи
	//@name: Как подписывать приложения | type: string | desc: {name}, {generic}, {exec}, {categories}
	drun-display-format:        "{name}";
	//@name: Как подписывать окна | type: string | desc: {w} — рабочий стол, {c} — класс, {t} — заголовок
	window-format:              "{w} · {c} · {t}";
//@end
}

/*****----- Global Properties -----*****/
@import                          "colors.rasi"
@import                          "fonts.rasi"

* {
    border-colour:               var(primary);
    handle-colour:               var(on-surface);
    background-colour:           var(surface);
    foreground-colour:           var(on-surface);
    alternate-background:        var(surface-container);
    normal-background:           @element-bg;
    normal-foreground:           var(on-surface);
    urgent-background:           var(error);
    urgent-foreground:           var(on-error);
    active-background:           var(primary-container);
    active-foreground:           var(on-primary-container);
    selected-normal-background:  var(primary);
    selected-normal-foreground:  var(on-primary);
    selected-urgent-background:  var(error-container);
    selected-urgent-foreground:  var(on-error-container);
    selected-active-background:  var(secondary-container);
    selected-active-foreground:  var(on-secondary-container);
    alternate-normal-background: @element-bg;
    alternate-normal-foreground: var(on-surface-variant);
    alternate-urgent-background: var(error);
    alternate-urgent-foreground: var(on-error);
    alternate-active-background: var(primary-container);
    alternate-background:        @element-bg;
    alternate-active-foreground: var(on-primary-container);
wbg:var(surface);
element-bg:var(surface-container-low);
    }
/*****----- Main Window -----*****/
window {
    transparency:                "real";
//@section Окно
    //@name: Где открывать | type: enum | options: west, center, north, south, east
    location:                    west;
    //@name: К чему прижимать | type: enum | options: west, center, north, south, east
    anchor:                      west;
    fullscreen:                  false;
    //@name: Ширина | type: string | desc: В px или %
    width:                       400px;
    //@name: Высота | type: string | desc: В px или %
    height:                      98.7%;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    //@name: Отступ от края | type: string | desc: сверху справа снизу слева
    margin:                      0px 0px 0px 8px;
    //@name: Скругление окна | type: string
    border-radius:               18px;
//@end
    padding:                     2px;
    border:                      0px solid 0px;
    border-color:                var(outline-variant);
    cursor:                      "default";
    background-color:            @wbg;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     16px;
    border:                      0px;
    border-radius:               0px;
    border-color:                var(outline);
    children:                    [ "inputbar", "message", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
//@section Строка поиска
    //@name: Расстояние в строке поиска | type: string
    spacing:                     20px;
    margin:                      0px 0px 8px 0px;
    padding:                     12px;
    //@name: Скругление строки поиска | type: string
    border-radius:               25px;
//@end
    border-color:                var(outline);
    background-color:            @element-bg;
    text-color:                  var(on-surface);
    children:                    ["entry","prompt"];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    margin: 			 0 4px;
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "::";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
//@section Поле ввода
    //@name: Подсказка в поиске | type: string
    placeholder:                 "Type to search";
    //@name: Прозрачность текста | type: float | range: 0-1 | step: 0.05
    opacity:                     0.3;
//@end
    placeholder-color:           var(on-surface-variant);
}
num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    background-color:            inherit;
    text-color:                  inherit;
}
num-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
case-indicator {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
//@section Список
    //@name: Колонок | type: int | range: 1-6
    columns:                     1;
    //@name: Строк | type: int | range: 1-20
    lines:                       8;
    //@name: По кругу | type: bool | desc: После последнего пункта — снова первый
    cycle:                       true;
    dynamic:                     true;
    //@name: Полоса прокрутки | type: bool
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    //@name: Расстояние между пунктами | type: string
    spacing:                     6px;
//@end
    margin:                      0px;
    padding:                     4px 0px;
    border:                      0px;
    background-color:            transparent;
}

scrollbar {
    handle-width:                5px ;
    handle-color:                @handle-colour;
    border-radius:               12px;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
//@section Пункты
    //@name: Расстояние значок — текст | type: string
    spacing:                     18px;
    margin:                      2px;
    //@name: Внутренний отступ пункта | type: string
    padding:                     10px;
    border:                      0px solid;
    //@name: Скругление пункта | type: string
    border-radius:               12px;
//@end
    background-color:            transparent;
    text-color:                  var(on-surface);
    cursor:                      pointer;
    orientation:                 horizontal;
}

element.selected {
    background-color:            var(primary);
    background-image:            var(gradient);
    text-color:                  var(on-primary);
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
//@section Значки
    //@name: Размер значков | type: string
    size:                        38px;
//@end
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Mode Switcher -----*****/
mode-switcher{
//@section Переключатель режимов
    //@name: Переключатель режимов | type: bool | desc: Кнопки внизу
    enabled:                     true;
    spacing:                     8px;
    margin:                      8px 0px 0px 0px;
    padding:                     5px;
    border:                      0.3px solid;
    //@name: Скругление переключателя | type: string
    border-radius:               25px;
//@end
    border-color:                var(outline);
    background-color:            @element-bg;
}

button {
    padding:                     7px 12px;
    border-radius:               25px;
    background-color:            transparent;
    text-color:                  var(on-surface-variant);
    cursor:                      pointer;
}
button selected {
    background-color:            var(primary);
    background-image:            var(gradient);
    text-color:                  var(on-primary);
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     8px 8px;
    border:                      1px solid;
    border-radius:               8px;
    border-color:                var(outline);
    background-color:            var(surface-container);
    text-color:                  var(on-surface);
}
textbox {
    padding:                     8px;
    border:                      0px solid;
    border-radius:               4px;
    border-color:                var(outline);
    background-color:            var(surface-container);
    text-color:                  var(on-surface);
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           var(on-surface);
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            @background-colour;
    text-color:                  @foreground-colour;
}
